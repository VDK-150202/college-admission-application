APP_NAME=College Admission Eligibility API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FILE=logs/admissions.log

# Local Windows mode uses localhost. Docker Compose overrides DB_HOST to
# the SQL Server service name "sqlserver" for container-to-container access.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CollegeAdmissions
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
